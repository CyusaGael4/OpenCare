# ------------------------------------------------------------------------------
# OpenCare backend environment template
#
# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must never be committed or shared.
# ------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Browser origin allowed to call the API with credentials.
# Single origin, no trailing slash. Add more via CLIENT_ORIGINS (comma separated)
# only if you deliberately need additional dev hosts (e.g. a LAN IP for phone testing).
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Full MongoDB connection string. For Atlas use the mongodb+srv:// form.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Database name used when the URI does not already specify one.
MONGODB_DB_NAME=opencare

# --- Sessions ---------------------------------------------------------------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Required in production. In development a random per-process secret is generated
# if this is omitted, which invalidates sessions on restart.
SESSION_SECRET=replace-with-a-long-random-string
# Session lifetime in milliseconds (default 24 hours).
SESSION_MAX_AGE_MS=86400000
# Set to "true" when serving over HTTPS so cookies are marked Secure.
# Defaults to true automatically when NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# --- Clinic -----------------------------------------------------------------
# Clinic wall-clock timezone label used for display and documentation.
# OpenCare stores appointment dates as calendar dates and times as HH:mm,
# so this does not shift stored values.
CLINIC_TIMEZONE=Africa/Kigali
